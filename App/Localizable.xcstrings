    },
    "The name isn't valid for NTFS. Nothing was erased." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên không hợp lệ với NTFS. Không có gì bị xóa."
          }
        }
      }
    },
    "The new language is used the next time NTFS for Mac opens." : {
      "localizations" : {
