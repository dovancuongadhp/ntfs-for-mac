        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB flash"
          }
        }
      }
    },
    "Use Eject in Finder or in the menu bar so all changes are written to the drive." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng nút Đẩy ra trong Finder hoặc trên thanh menu để mọi thay đổi được ghi hết vào ổ."
          }
        }
