          }
        }
      }
    },
    "The drive was erased and formatted as exFAT, but NTFS formatting didn't finish (%@). Format it again as NTFS." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ổ đã được xóa và định dạng exFAT, nhưng bước định dạng NTFS chưa hoàn tất (%@). Hãy định dạng lại thành NTFS."
          }
        }
      }
    },
    "The drive's partition table looks different than expected, so NTFS for Mac stopped." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng phân vùng của ổ khác với dự kiến nên NTFS for Mac đã dừng lại."
