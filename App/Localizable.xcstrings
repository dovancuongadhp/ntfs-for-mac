{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld" : {
      "shouldTranslate" : false
    },
    "A drive is being formatted" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ổ đang được định dạng"
          }
        }
      }
    },
    "A full format writes zeros over the whole partition and can take a long time." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Định dạng đầy đủ ghi số 0 lên toàn bộ phân vùng và có thể mất nhiều thời gian."
          }
        }
      }
    },
    "A write to the drive failed, so writing was stopped to protect your data. Eject the drive and check the cable or the drive itself." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi dữ liệu vào ổ bị lỗi nên việc ghi đã được dừng để bảo vệ dữ liệu của bạn. Hãy đẩy ổ ra và kiểm tra lại cáp hoặc chính ổ đĩa."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
