    },
    "Updating NTFS for Mac…" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang cập nhật NTFS for Mac…"
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản"
          }
        }
      }
    },
    "Wait until formatting finishes before quitting NTFS for Mac." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chờ định dạng xong rồi mới thoát NTFS for Mac."
          }
        }
      }
    },
    "Whole drive %@ · %@ · every partition and volume on it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toàn bộ ổ %1$@ · %2$@ · mọi phân vùng và ổ con trên đó."
          }
        }
      }
    },
    "Windows flagged this drive for a disk check. Run “chkdsk /f” on it in Windows, then reconnect it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows đã đánh dấu ổ này cần kiểm tra. Hãy chạy “chkdsk /f” cho ổ trên Windows rồi cắm lại."
          }
        }
      }
    },
    "Windows is hibernated" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows đang ngủ đông"
          }
        }
      }
    },
    "Windows was hibernated or Fast Startup is on. Start Windows and choose Shut Down while holding Shift, or turn off Fast Startup, then reconnect the drive." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows đang ngủ đông hoặc bật Khởi động nhanh (Fast Startup). Hãy vào Windows, giữ Shift khi chọn Shut Down, hoặc tắt Khởi động nhanh, rồi cắm lại ổ."
          }
        }
      }
    },
    "write error" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lỗi ghi"
          }
        }
      }
    },
    "writing turned off" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "đã tắt ghi"
          }
        }
      }
    },
    "You'll be asked for an administrator password to finish formatting as NTFS. If you cancel it, the drive stays exFAT. The first time, allow access to removable volumes." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ được yêu cầu nhập mật khẩu quản trị viên để hoàn tất định dạng NTFS. Nếu bạn hủy, ổ vẫn giữ định dạng exFAT. Lần đầu, hãy cho phép truy cập ổ rời."
          }
        }
      }
    },
    "You'll be asked for an administrator password. The first time, allow access to removable volumes." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ được yêu cầu nhập mật khẩu quản trị viên. Lần đầu, hãy cho phép truy cập ổ rời."
          }
        }
      }
    },
    "macOS blocked access to this drive. In System Settings → Privacy & Security → Files & Folders, allow NTFS for Mac to access removable volumes, then try again." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS đã chặn truy cập ổ này. Trong Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Tệp và thư mục, hãy cho phép NTFS for Mac truy cập ổ rời, rồi thử lại."
          }
        }
      }
    },
    "macOS blocked access to the drive" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS đã chặn truy cập ổ"
          }
        }
      }
    },
